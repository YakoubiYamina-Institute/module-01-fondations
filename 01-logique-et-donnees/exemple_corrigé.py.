# 🟧 SEMAINE 1 : VÉRIFICATION D'ÂGE
# 🤲 Niyyah : Protéger la vérité des données (Sidq).

age = input("Quel est votre âge ? ")

# 🛡️ SECURITY : On s'assure que c'est un nombre
try:
    age_int = int(age)
    
    # ⚖️ JUSTICE : Vérification de la cohérence (0-120 ans)
    if 0 <= age_int <= 120:
        print("✅ Donnée vérifiée. Merci pour votre honnêteté.")
    else:
        print("❌ Erreur : Cette donnée semble fausse. La vérité est une obligation.")
        
except ValueError:
    print("❌ Erreur : Veuillez entrer un nombre entier.")
